{
  "expo": {
    "name": "SonicAM",
    "slug": "sonicam-mobile",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0907"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ashraf.sonicam",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SonicAM needs microphone access to listen to ambient songs and detect music."
      }
    },
    "android": {
      "package": "com.ashraf.sonicam",
      "versionCode": 4,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0907"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
